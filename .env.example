# Copy to .env and adjust. The compose stack and the Go binary read these.

# --- Postgres (deploy/docker-compose.yml) ---
POSTGRES_USER=ais
POSTGRES_PASSWORD=ais
POSTGRES_DB=ais
POSTGRES_PORT=5432

# --- Application (api/cmd/tracker) ---
# Connection string the service uses to reach Postgres.
DATABASE_URL=postgres://ais:ais@localhost:5432/ais?sslmode=disable

APP_ENV=dev            # dev | prod
HTTP_PORT=8080
LOG_LEVEL=info         # debug | info | warn | error
LOG_FORMAT=text        # text | json
SHUTDOWN_GRACE_SECONDS=30
WORKER_POOL_SIZE=10
# Postgres pool size; unset means WORKER_POOL_SIZE + 10.
DB_MAX_CONNS=
# Raw AIS messages older than this are pruned hourly.
RAW_RETENTION_HOURS=48

# --- Production (deploy/deploy.sh on ganymede) ---
# Public hostname Traefik routes to the tracker.
TRACKER_HOST=ais.roythan.de
# Memory caps for the shared host; raise them on a bigger box.
POSTGRES_MEM_LIMIT=1536m
TRACKER_MEM_LIMIT=512m

# --- AIS sources (Phase 1) ---
# Optional; AISStream allows anonymous connections at lower rate limits.
AISSTREAM_API_KEY=

# --- Alerts (Phase 5) ---
# Optional; set both to enable the Telegram alert dispatch adapter.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
