{
  "name": "ais-tracker-ui",
  "description": "ais-tracker operator terminal (Qwik), built static into ../api/internal/webui/dist",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build.types && npm run build.client && npm run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.2",
    "@builder.io/qwik-city": "^1.20.2",
    "@eslint/js": "^9",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.2",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "undici": "*",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1",
    "leaflet": "^1.9.4",
    "@types/leaflet": "^1.9.22",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0"
  }
}
